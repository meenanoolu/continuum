# Meta Model API (planning, Gate, grading, vision) - https://dev.meta.ai
META_API_KEY=your_meta_model_api_key_here
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low

# Baseten: Muse Spark Open (open weights) runs the Workers
BASETEN_API_KEY=your_baseten_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_REASONING_EFFORT=low

# Muse Spark always reasons; reasoning tokens count against the output cap.
# This many extra tokens are added to every request so answers never come back empty.
REASONING_HEADROOM=2500

# Optional: delegate coding to Meta's Muse Code CLI (needs the `muse` binary on PATH). Verified independently either way.
USE_MUSE_CODE=0

# Local files
MEMORY_PATH=./data/personal_memory.json
SESSION_PATH=./data/session.json
WORKSPACE_DIR=./workspace
